            "browser",
            "user"
          ]
        }
      ],
      "steps": [
        {
          "title": "Open",
          "desc": "The agent opens the page, or hands you the file.",
          "msgs": [
            {
              "from": "agent",
              "to": "browser",
              "kind": "http",
              "info": "open oauth.html",
